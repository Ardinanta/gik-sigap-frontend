{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gik-sigap-backend-production.up.railway.app/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://gik-sigap-backend-production.up.railway.app/sanctum/:path*" },
    { "source": "/storage/:path*", "destination": "https://gik-sigap-backend-production.up.railway.app/storage/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" },
      { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
    ] },
    { "source": "/sanctum/:path*", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" },
      { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
    ] }
  ]
}
